# Copy to .env.local (never commit real values; .env* is gitignored except this file).

# ── Database ─────────────────────────────────────────────────────────────
# Defaults to the local SQLite file. Point at libSQL/Turso for deployment.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# ── Sign-in (Clerk) ──────────────────────────────────────────────────────
# Local dev without a Clerk account: `npx -y clerk@latest init --accountless` writes temporary
# (keyless/accountless) pk_test_/sk_test_ keys into .env.local — see README → Sign-in.
# Production needs real keys from dashboard.clerk.com → your app → API keys (Production instance:
# pk_live_/sk_live_). Without any keys, only BCB_AUTH_BYPASS=1 (tests) lets the app run.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_...
# CLERK_SECRET_KEY=sk_live_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Optional: only this email may claim the Owner account on a fresh install (first sign-in).
# BCB_OWNER_EMAIL=you@yourbusiness.com.au

# ── Tests only ───────────────────────────────────────────────────────────
# BCB_AUTH_BYPASS=1 skips sign-in and acts as the first active Owner, for the Playwright suites.
# Ignored on deployed Vercel production sites (NODE_ENV=production + VERCEL). Never set it in production.
# BCB_AUTH_BYPASS=
