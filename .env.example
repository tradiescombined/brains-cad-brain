# Settings template. Never commit real values (.env* is gitignored except this file).
#   Self-hosted server: `npm run setup` copies this to .env — edit .env, then run `npm run setup` again
#     (NEXT_PUBLIC_* values are built into the app) and restart. Guide: docs/SELF-HOSTING.md
#   Local development: copy to .env.local instead.

# ── Sign-in (Clerk) ──────────────────────────────────────────────────────
# From dashboard.clerk.com → your application → Configure → API keys.
#   Development instance (pk_test_/sk_test_): fine on your local network (http://<server-ip>:3000).
#   Production instance  (pk_live_/sk_live_): needs your own domain with HTTPS (Cloudflare Tunnel).
# Local dev without a Clerk account: `npx -y clerk@latest init --accountless` writes temporary
# keys into .env.local — see README → Sign-in. Without keys nobody can sign in.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# Optional: only this email may claim the Owner account on a fresh install (first sign-in).
# BCB_OWNER_EMAIL=you@yourbusiness.com.au

# ── Server (npm run serve) ───────────────────────────────────────────────
# PORT=3000
# HOST=0.0.0.0        # 0.0.0.0 = other devices on your network can connect; 127.0.0.1 = this computer
#                     # only (use that with Cloudflare Tunnel, which connects from this computer)

# ── Backups (npm run backup, nightly with npm run service:install) ───────
# Also copy each backup to this folder (iCloud Drive / Dropbox / OneDrive / USB drive / NAS). ~ = home folder.
# Mac + iCloud Drive:
# BCB_BACKUP_DIR=~/Library/Mobile Documents/com~apple~CloudDocs/BrainsCadBrain-backups
# How many backups to keep (in backups/ and in BCB_BACKUP_DIR):
# BCB_BACKUP_KEEP=30

# ── Database ─────────────────────────────────────────────────────────────
# Defaults to the local SQLite file data/bcb.db. Point at libSQL/Turso for a hosted database.
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# ── Tests only — NEVER on a server ───────────────────────────────────────
# BCB_AUTH_BYPASS=1 skips sign-in and acts as the first active Owner, for the Playwright suites.
# In a production build (`next start`) it also needs BCB_ALLOW_TEST_BYPASS=1; it is always ignored on
# deployed Vercel sites, and `npm run serve` refuses to start if either is set.
