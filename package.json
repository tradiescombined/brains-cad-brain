{
  "name": "brains-cad-brain",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "serve": "node scripts/serve.mjs",
    "update": "node scripts/update.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "doctor": "node scripts/doctor.mjs",
    "service:install": "node scripts/service.mjs install",
    "service:uninstall": "node scripts/service.mjs uninstall",
    "service:start": "node scripts/service.mjs start",
    "service:stop": "node scripts/service.mjs stop",
    "service:status": "node scripts/service.mjs status",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "drizzle-kit push --force",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "rm -f data/bcb.db && drizzle-kit push --force && tsx scripts/seed.ts",
    "db:demo": "rm -f data/bcb.db && drizzle-kit push --force && tsx scripts/seed.ts && tsx scripts/seed-demo.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "e2e:all": "node scripts/e2e-all.mjs",
    "e2e": "for f in e2e/*.e2e.mjs; do echo \"== $f\"; node $f || exit 1; done"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.10.2",
    "@libsql/client": "^0.18.0",
    "drizzle-orm": "^0.45.4",
    "next": "16.4.6",
    "pdfjs-dist": "^6.5.438",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "playwright-core": "^1.65.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
